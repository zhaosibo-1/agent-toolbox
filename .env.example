# ==========================================================================
#  Agent 工具箱 - 环境变量模板
#  用法：cp .env.example .env  然后填入你自己的 Key
#  ⚠️ .env 已被 .gitignore 排除，切勿把真实 Key 提交到 GitHub
# ==========================================================================

# --------------------------------------------------------------------------
# 大模型配置（OpenAI 兼容协议）
# 可选 preset：deepseek | qwen | moonshot | zhipu | siliconflow | openai | custom
# --------------------------------------------------------------------------
LLM_PRESET=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# --------------------------------------------------------------------------
# Agent 行为
# --------------------------------------------------------------------------
# 单次任务最多允许的工具调用轮数（防止模型陷入无限循环）
MAX_STEPS=8
# 是否把工具执行结果回灌给模型继续推理
ENABLE_TOOL_RESULT_FEEDBACK=true
# Agent 模式：auto（优先 Function Calling，不支持则降级 ReAct 文本协议）
#            function_call | react
AGENT_MODE=auto
# 单次工具执行超时（秒）
TOOL_TIMEOUT=15

# --------------------------------------------------------------------------
# 工具安全限制
# --------------------------------------------------------------------------
# 允许读取的本地目录（逗号分隔，留空表示禁用文件类工具）
ALLOWED_FILE_DIRS=./examples
# HTTP 工具允许访问的域名白名单（留空表示不限制，生产环境建议收紧）
HTTP_ALLOWED_HOSTS=
# 计算器允许的表达式最大长度
CALC_MAX_LENGTH=200

# --------------------------------------------------------------------------
# 服务
# --------------------------------------------------------------------------
CORS_ORIGINS=*
MAX_UPLOAD_MB=5
